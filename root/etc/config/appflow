config appflow 'main'
	# Netify Agent JSON export socket (netifyd.conf: [socket] listen_path[0]).
	option socket_path '/var/run/netifyd/netifyd.sock'

	# Maximum concurrently tracked flows. The flow table is the daemon's only
	# significant memory consumer; 4096 flows is roughly 3 MB of state.
	option flow_max '4096'

	# Sliding window, in seconds, behind the reported rates. netifyd delivers
	# per-flow counters about every 15 s, so values below ~20 s make the rates
	# jump between burst and idle rather than making them more responsive.
	option rate_window '30'

	# Default number of rows returned by the summary method.
	option top_n '10'

	# Drop a flow from the table after this many seconds without an update.
	option idle_timeout '300'

	# Break AI services out as their own applications and category.
	#
	# netifyd cannot classify them: its signature set is dated August 2023 and
	# contains no AI vendors at all, so this traffic arrives as generic HTTP/S.
	# The TLS SNI is already in the flow record, so appflowd matches it against
	# a built-in table of AI service domains and relabels the flow.
	#
	# This is HOSTNAME MATCHING, NOT DPI. It asserts a classification netifyd
	# did not make. netifyd's own answer always wins except for a handful of
	# services whose parent brand netifyd recognises (Gemini under Google,
	# Copilot under GitHub), so this falls silent by itself if Netify ever ship
	# AI signatures. It changes identity only and never affects byte accounting.
	#
	# 0 disables it entirely.
	option ai_breakout '1'
